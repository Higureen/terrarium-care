          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "terrarium_id",
                  "name",
                  "species"
                ],
                "properties": {
                  "terrarium_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Vardas negali būti sudarytas tik iš tarpų."
                  },
                  "species": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150,
                    "description": "Rūšis negali būti sudaryta tik iš tarpų."
                  },
                  "arrival_date": {
                    "type": "string",
                    "format": "date",
                    "nullable": true
                  },
                  "notes": {
                    "type": "string",
                    "nullable": true
                  }
                }
              },
              "example": {
                "terrarium_id": 1,
                "name": "Mėta",
                "species": "Litoria caerulea",
                "arrival_date": "2026-10-03",
                "notes": "Aktyvi vakare."
